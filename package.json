{
  "name": "bale-forum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test dev http://127.0.0.1:5173 cypress:run",
    "ci:test": "npm test && npm run e2e:ci",
    "cypress:run:chrome": "cypress run --browser chrome",
    "e2e:ci": "start-server-and-test dev http://127.0.0.1:5173 cypress:run:chrome"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "bootstrap": "^5.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-redux-loading-bar": "^5.0.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.3.0",
    "eslint": "^10.13.0",
    "eslint-config-dicodingacademy": "^0.9.5",
    "eslint-plugin-cypress": "^7.0.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
